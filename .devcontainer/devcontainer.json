{
  "name": "ARIA — full stack (Go · Python · Next.js)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26.1" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.13" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },

  "forwardPorts": [3000, 8000, 8080],
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)", "onAutoForward": "openBrowserOnce" },
    "8000": { "label": "Python API (FastAPI)" },
    "8080": { "label": "Go server (WebSocket hub)" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/backend"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python"
      }
    }
  },

  "hostRequirements": { "cpus": 2, "memory": "8gb" }
}
