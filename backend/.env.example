ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
DEBUG=false
HOST=0.0.0.0
PORT=8080
PYTHON_BIN=/path/to/your/python3
VISION_SCRIPT=app/pipeline/vision_worker.py
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2
AUDIO_ENABLED=true
WHISPER_MODEL=tiny
KMP_DUPLICATE_LIB_OK=TRUE
# Shared secret for the Go<->Python internal trust boundary (Go sends it as
# X-Internal-Auth; Python requires it). Leave empty for local dev to disable
# enforcement; set the SAME value on both services in deploy.
INTERNAL_AUTH_SECRET=
