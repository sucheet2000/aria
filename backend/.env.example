ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
DEBUG=false
HOST=0.0.0.0
PORT=8080
PYTHON_BIN=/path/to/your/python3
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2
AUDIO_ENABLED=true
WHISPER_MODEL=tiny
KMP_DUPLICATE_LIB_OK=TRUE
# Deploy environment name. Leave as "local" for local dev; set ENV=production
# in the cloud. A non-local ENV requires INTERNAL_AUTH_SECRET or the service
# refuses to boot (fail closed).
ENV=local
# Shared secret for the Go<->Python internal trust boundary (Go sends it as
# X-Internal-Auth; Python requires it). Leave empty for local dev to disable
# enforcement; set the SAME value on both services in deploy.
INTERNAL_AUTH_SECRET=

# Scrape credential for GET /metrics, which publishes operational counters and
# Claude token spend. A scraper sends `Authorization: Bearer $METRICS_TOKEN`.
# This is NOT a Clerk user token — monitoring is a machine caller, and a
# person's session must neither be required nor accepted here.
#
# Containers always bind 0.0.0.0, so the server treats a non-loopback bind as
# "reachable by others" and refuses to start when this is empty. Set
# ALLOW_INSECURE_METRICS=1 only if you deliberately want it readable with no
# credential.
METRICS_TOKEN=
# Set to 1 only to deliberately serve /metrics with no credential.
#ALLOW_INSECURE_METRICS=1
# Base directory for durable user data (ChromaDB memory + SQLite anchors).
# Local dev: leave this commented out — it defaults to backend/ (memory/ +
# data/anchors.db), so the layout is unchanged.
# Cloud (Railway): set to the mounted volume path so memory and anchors survive
# redeploys.
# DATA_DIR=/data
