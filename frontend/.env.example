# Backend endpoint configuration for the ARIA frontend.
# Copy to .env.local for local overrides. Values must be prefixed with
# NEXT_PUBLIC_ so Next.js exposes them to the browser bundle.

# Base URL of the Go server (HTTP/HTTPS). Used for cognition, TTS, memory,
# and spatial anchor requests. Defaults to http://localhost:8080.
NEXT_PUBLIC_API_BASE=http://localhost:8080

# WebSocket URL of the Go server. Optional — if unset, it is derived from
# NEXT_PUBLIC_API_BASE (http -> ws, https -> wss, with a /ws suffix).
# Set explicitly only when the WS endpoint differs from the HTTP base.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
